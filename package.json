{
  "name": "page2ai-benchmark",
  "private": true,
  "version": "0.2.0",
  "description": "Open comparison of web-to-Markdown extractors on documentation frameworks. By Igor Saevets.",
  "type": "module",
  "author": {
    "name": "Igor Saevets",
    "email": "igorsaevets@gmail.com",
    "url": "https://igorsaevets.github.io/page2ai-docs/about/"
  },
  "license": "MIT",
  "homepage": "https://igorsaevets.github.io/page2ai-docs/comparison/",
  "repository": {
    "type": "git",
    "url": "https://github.com/igorsaevets/page2ai-benchmark.git"
  },
  "scripts": {
    "bench": "node run.mjs",
    "bench:jina": "node runners/jina.mjs",
    "bench:firecrawl": "node runners/firecrawl.mjs",
    "bench:page2ai": "node runners/page2ai.mjs",
    "metrics": "node metrics.mjs",
    "report": "node report.mjs",
    "probe:negotiation": "node content-negotiation-survey.mjs",
    "probe:accept": "node repro-accept.mjs",
    "probe:passthrough": "node repro-passthrough.mjs",
    "probe:vary": "node vary-check.mjs",
    "probe:ua": "node ua-sensitivity.mjs",
    "probe:tool-headers": "node tool-accept-matrix.mjs",
    "audit:webmainbench": "node webmainbench-groundtruth-audit.mjs",
    "v2:fetch": "node protocol-v2/fetch.mjs",
    "v2:groundtruth": "node protocol-v2/groundtruth.mjs",
    "v2:extract": "node protocol-v2/extract.mjs",
    "v2:score": "node protocol-v2/score.mjs",
    "v2:report": "node protocol-v2/report.mjs",
    "v2:negotiation": "node protocol-v2/negotiation.mjs",
    "v2": "node protocol-v2/groundtruth.mjs && node protocol-v2/extract.mjs && node protocol-v2/score.mjs && node protocol-v2/toc_audit.mjs && node protocol-v2/report.mjs",
    "v2:tocaudit": "node protocol-v2/toc_audit.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@page2ai/core": "^0.1.5",
    "defuddle": "^0.19.2",
    "jsdom": "^30.0.1",
    "linkedom": "^0.18.0",
    "turndown": "^7.2.4"
  }
}
